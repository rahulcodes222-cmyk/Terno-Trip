# ─── JWT Secrets ─────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_strong_random_secret
JWT_REFRESH_SECRET=replace_with_another_strong_random_secret

# ─── Internal Service Secret ──────────────────────────────────────────────────
INTERNAL_SERVICE_SECRET=replace_with_a_strong_random_secret

# ─── Service URLs ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
API_GATEWAY_URL=http://localhost:4000
AUTH_SERVICE_URL=http://localhost:4001
USER_SERVICE_URL=http://localhost:4002
TRIP_SERVICE_URL=http://localhost:4003
BOOKING_SERVICE_URL=http://localhost:4004
PAYMENT_SERVICE_URL=http://localhost:4005
NOTIFICATION_SERVICE_URL=http://localhost:4006

# ─── Environment ─────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Cashfree Payment Gateway ─────────────────────────────────────────────────
# Get from: https://merchant.cashfree.com/ → Developers → API Keys
# Add to: services/payment-service/.env
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=sandbox            # sandbox | production
CASHFREE_API_URL=https://sandbox.cashfree.com/pg
PAYMENT_PROVIDER=cashfree       # mock | cashfree
PAYMENT_WEBHOOK_URL=http://localhost:4005/api/v1/payments/webhook

# ─── Email / SMTP ─────────────────────────────────────────────────────────────
# Add to: services/notification-service/.env
# Gmail: Enable 2FA → generate App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=TernoTrip <your_gmail@gmail.com>
ADMIN_EMAIL=admin@yoursite.com  # Booking alerts go here
