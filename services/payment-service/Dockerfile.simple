# SIMPLE DOCKERFILE - Use pre-built files
FROM node:20-alpine

WORKDIR /app

# Copy pre-built dist files (build them locally first)
COPY packages/shared/dist ./packages/shared/dist/
COPY packages/shared/package.json ./packages/shared/

COPY services/shared-events/dist ./services/shared-events/dist/
COPY services/shared-events/package.json ./services/shared-events/

COPY services/payment-service/dist ./services/payment-service/dist/
COPY services/payment-service/package.json ./services/payment-service/

# Create package.json with file dependencies
RUN cat > package.json << 'EOF'
{
  "dependencies": {
    "@terno/shared": "file:./packages/shared",
    "@terno/shared-events": "file:./services/shared-events"
  }
}
EOF

# Install dependencies
RUN npm install --production

EXPOSE 4005
CMD ["node", "services/payment-service/dist/index.js"]