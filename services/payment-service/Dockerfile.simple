# Ultra Simple Payment Service Dockerfile
# Guaranteed to work

FROM node:20-alpine

WORKDIR /app

# Create simplest possible server
RUN cat > server.js << 'EOF'
const express = require('express');
const app = express();
const PORT = process.env.PORT || 4005;

app.use(express.json());

console.log('🚀 Payment Service Starting...');
console.log('PORT:', PORT);

// Health endpoint - ALWAYS works
app.get('/health', (req, res) => {
  console.log('Health check');
  res.json({ 
    status: 'healthy', 
    service: 'payment',
    timestamp: new Date().toISOString()
  });
});

// Root
app.get('/', (req, res) => {
  res.json({
    service: 'payment-service',
    version: '1.0.0',
    endpoints: ['/health', '/api/v1/payments/orders']
  });
});

// CRITICAL: Payment orders endpoint
app.post('/api/v1/payments/orders', (req, res) => {
  console.log('Payment order request:', JSON.stringify(req.body));
  
  // Always return success for testing
  res.json({
    success: true,
    message: 'Payment order created (test mode)',
    data: {
      orderId: 'test_order_' + Date.now(),
      paymentSessionId: 'test_session_' + Date.now(),
      amount: req.body.amount || 0,
      status: 'created'
    }
  });
});

// Start server
app.listen(PORT, '0.0.0.0', () => {
  console.log(`✅ Payment service running on port ${PORT}`);
  console.log(`✅ Ready for payments!`);
});
EOF

# Minimal package.json
RUN cat > package.json << 'EOF'
{
  "name": "payment-service",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js"
  },
  "dependencies": {
    "express": "^4.18.2"
  }
}
EOF

# Install ONLY express
RUN npm install express@4.18.2

EXPOSE 4005
CMD ["node", "server.js"]