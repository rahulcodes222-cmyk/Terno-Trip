PORT=4006
MONGODB_URI=your_mongodb_connection_url
INTERNAL_SERVICE_SECRET=replace_with_a_strong_random_secret
NODE_ENV=development

# ─── SMTP (required for booking/enquiry emails) ─────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username@gmail.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM=TernoTrip <noreply@terno-trip.com>
ADMIN_EMAIL=admin@terno-trip.com

# ─── Cashfree (payment gateway) ─────────────────────────────────────
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=sandbox
CASHFREE_API_URL=https://sandbox.cashfree.com/pg
FRONTEND_URL=https://terno-trip.vercel.app