# Build from project root, not services/booking-service
FROM node:20-alpine

WORKDIR /app

# Copy everything from current directory (project root)
COPY . .

# Debug
RUN echo "=== Current directory ===" && pwd
RUN echo "=== Listing files ===" && ls -la
RUN echo "=== Checking for services ===" && find . -name "services" -type d

# Since services directory exists now, continue with build
RUN npm ci --ignore-scripts
RUN npm run build --workspace=packages/shared
RUN npm run build --workspace=services/shared-events
RUN npm run build --workspace=services/booking-service

EXPOSE 4004
WORKDIR /app/services/booking-service
CMD ["node", "dist/index.js"]